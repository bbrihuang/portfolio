---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout title="Contact" description="Get in touch with me.">
  <section class="page-head page-body">
    <div class="container">
      <p class="section-label">04 / Contact</p>
      <h1 class="page-title">Let's build something.</h1>
      <p class="lede">
        I'm looking for internships and interesting problems. The fastest way to reach me is email.
      </p>
      <a href={`mailto:${profile.email}`} class="email">{profile.email} →</a>
      <div class="ctas">
        <a href={profile.socials.linkedin} class="btn" target="_blank" rel="noopener">LinkedIn</a>
        <a href={profile.socials.github} class="btn" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .email {
    display: inline-block;
    margin-top: 28px;
    font-family: var(--font-display);
    font-size: clamp(22px, 3.4vw, 32px);
    font-weight: 600;
    border-bottom: 2px solid var(--border-strong);
    padding-bottom: 4px;
    transition: border-color 0.15s;
    overflow-wrap: anywhere;
  }
  .email:hover {
    border-color: var(--text);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }
</style>
