---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout>
  <!-- ─── Intro ─── -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-main">
        <p class="status">
          <span class="dot"></span>
          {profile.status}
        </p>
        <h1>{profile.greeting}</h1>
        <p class="headline">{profile.headline}</p>
        <p class="bio">{profile.bio}</p>

        <div class="ctas">
          <a href="/projects/" class="btn btn-primary">
            View my work
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="/contact/" class="btn">Get in touch</a>
          {profile.resume && <a href={profile.resume} class="btn" target="_blank" rel="noopener">Resume</a>}
        </div>
      </div>

      <div class="side">
        <div class="profile card">
          <img src={profile.card.photo} alt={`Photo of ${profile.name}`} width="80" height="80" />
          <div class="profile-text">
            <p class="pname">{profile.name}</p>
            <a href={profile.socials.linkedin} class="handle mono" target="_blank" rel="noopener">{profile.card.handle}</a>
            <p class="school">{profile.card.school}</p>
            <p class="ptags mono"><span class="tag-dot"></span>{profile.card.tags}</p>
          </div>
        </div>

        <div class="term card" aria-label="Quick facts">
          <div class="term-bar">
            <span class="lights"><i class="r"></i><i class="y"></i><i class="g"></i></span>
            <span class="mono">bbrihuang@bu.edu:~</span>
          </div>
          <div class="term-body mono">
            {profile.terminal.map((line) => (
              <div class="line">
                <div class="cmd">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke={line.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {line.icon === 'terminal' && <><path d="m4 17 6-5-6-5" /><path d="M12 19h8" /></>}
                    {line.icon === 'rocket' && <><path d="M4.5 16.5c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2.1-.1-2.9a2.2 2.2 0 0 0-2.9-.1Z" /><path d="m12 15-3-3a22 22 0 0 1 2-3.9A12.9 12.9 0 0 1 22 2c0 2.7-.8 7.5-6 11a22.4 22.4 0 0 1-4 2Z" /><path d="M9 12H4s.6-3 2-4c1.6-1.1 5 0 5 0" /><path d="M12 15v5s3-.6 4-2c1.1-1.6 0-5 0-5" /></>}
                    {line.icon === 'wrench' && <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9l-3.8 3.8Z" />}
                    {line.icon === 'chip' && <><rect x="5" y="5" width="14" height="14" rx="2" /><rect x="9" y="9" width="6" height="6" rx="1" /><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3" /></>}
                  </svg>
                  <span>{line.cmd}</span>
                </div>
                <div class:list={['out', { bold: line.bold }]}>{line.out}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <dl class="metrics">
        {profile.metrics.map((m) => (
          <div>
            <dt class="mono">{m.value}</dt>
            <dd>{m.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

</BaseLayout>

<style>
  /* Intro */
  .hero {
    padding: 112px 0 80px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    gap: 56px;
    align-items: center;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(32px, 4.5vw, 46px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  .headline {
    margin-top: 24px;
    font-size: clamp(19px, 2.4vw, 23px);
    font-weight: 500;
    color: var(--text-2);
    max-width: 640px;
    line-height: 1.45;
  }
  .bio {
    margin-top: 18px;
    color: var(--muted);
    max-width: 620px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  /* Right column: profile card + terminal */
  .side {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .profile {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px;
  }
  .profile img {
    width: 80px;
    height: 80px;
    border-radius: 16px;
    object-fit: cover;
    border: 2px solid var(--border-strong);
    flex-shrink: 0;
  }
  .profile-text {
    min-width: 0;
  }
  .pname {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.25;
  }
  .handle {
    display: inline-block;
    font-size: 13px;
    color: #60a5fa;
    margin-top: 2px;
  }
  .handle:hover {
    text-decoration: underline;
  }
  .school {
    font-size: 13px;
    color: var(--muted);
    margin-top: 2px;
  }
  .ptags {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    color: var(--faint);
    margin-top: 4px;
  }
  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .term {
    overflow: hidden;
  }
  .term-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    color: var(--faint);
  }
  .lights {
    display: flex;
    gap: 7px;
  }
  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .lights .r { background: #f87171; opacity: 0.85; }
  .lights .y { background: #fbbf24; opacity: 0.85; }
  .lights .g { background: #34d399; opacity: 0.85; }
  .term-body {
    padding: 18px 20px 22px;
    font-size: 13px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cmd {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--faint);
  }
  .cmd svg {
    flex-shrink: 0;
  }
  .out {
    color: var(--text-2);
    padding-left: 24px;
    margin-top: 4px;
    font-size: 12.5px;
  }
  .out.bold {
    color: var(--text);
    font-weight: 700;
  }

  /* Metrics */
  .metrics {
    margin: 72px 0 0;
    padding-top: 36px;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .metrics dt {
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .metrics dd {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--faint);
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .term {
      max-width: 480px;
    }
  }
  @media (max-width: 760px) {
    .hero {
      padding: 72px 0 56px;
    }
    .metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 28px;
      margin-top: 56px;
    }
  }
</style>
